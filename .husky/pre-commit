RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m' 

npm run check || {
  echo ""
  echo "${RED}───────────────────────────────────────────────${NC}"
  echo "${RED}✖ Commit blocked!${NC}"
  echo "${YELLOW}Your code failed lint or build checks.${NC}"
  echo ""
  echo "${CYAN}Fix the issues, then retry:${NC}"
  echo "  ${YELLOW}npm run lint${NC}"
  echo "  ${YELLOW}npm run build${NC}"
  echo "${RED}───────────────────────────────────────────────${NC}"
  echo ""
  exit 1
}

echo ""
echo "${GREEN}✔ All checks passed — committing changes...${NC}"
echo ""